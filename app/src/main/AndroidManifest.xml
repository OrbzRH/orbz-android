<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wallets the connect sheet may hand off to. Android only lets an app see packages it declares. -->
    <queries>
        <package android:name="io.metamask" />
        <package android:name="com.wallet.crypto.trustapp" />
        <package android:name="me.rainbow" />
        <package android:name="org.toshi" />
        <package android:name="io.zerion.android" />
        <package android:name="io.gnosis.safe" />
        <package android:name="vip.mytokenpocket" />
        <package android:name="com.okinc.okex.gp" />
        <package android:name="com.bitkeep.wallet" />
        <package android:name="com.debank.rabbymobile" />
        <package android:name="app.phantom" />
        <package android:name="im.token.app" />
        <package android:name="com.coinbase.android" />
        <package android:name="com.binance.dev" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wc" />
        </intent>
    </queries>

    <application
        android:name=".OrbzApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbz">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Orbz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where a wallet sends the user back after signing: orbz://request -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbz" android:host="request" />
            </intent-filter>
        </activity>
    </application>
</manifest>
